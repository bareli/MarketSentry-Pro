{
  "config": {
    "step": {
      "user": {
        "title": "Add a provider account",
        "description": "Choose which market data provider this account tracks. Credentials (if needed) are entered once; instruments are added afterward without re-entering them.",
        "data": {
          "provider": "Provider"
        }
      },
      "finnhub_credentials": {
        "title": "Finnhub API key",
        "description": "Finnhub's free tier is personal, non-commercial use only. Get a free key at finnhub.io.",
        "data": {
          "api_key": "API key"
        }
      },
      "alpaca_credentials": {
        "title": "Alpaca API credentials",
        "description": "Free Basic plan: IEX feed only, not the consolidated tape.",
        "data": {
          "key_id": "Key ID",
          "secret_key": "Secret key",
          "feed": "Feed"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid credentials.",
      "cannot_connect": "Could not reach the provider. Try again later."
    },
    "abort": {
      "already_configured": "This provider account is already configured."
    }
  },
  "config_subentries": {
    "instrument": {
      "entry_type": "Instrument",
      "initiate_flow": {
        "user": "Add instrument",
        "reconfigure": "Edit instrument options"
      },
      "step": {
        "user": {
          "title": "Track an instrument",
          "description": "Paste a URL/slug (Polymarket), ticker (stocks, e.g. AAPL, MSFT, TSLA), coin id (crypto, e.g. bitcoin, ethereum), or pair like EUR/ILS (FX; add /boi for the Bank of Israel official rate instead of the market rate). Free text also works as a search.",
          "data": {
            "url_or_query": "URL, ticker, or pair"
          }
        },
        "select": {
          "title": "Multiple matches",
          "description": "Pick one. Run \"Add instrument\" again for any others.",
          "data": {
            "instrument": "Instrument"
          }
        },
        "confirm": {
          "title": "Confirm and set thresholds",
          "description": "Tracking **{name}** ({symbol}).",
          "data": {
            "thresholds": "Thresholds (comma-separated)",
            "hysteresis": "Hysteresis",
            "move_delta": "Price move trigger",
            "move_window_min": "Price move window (minutes)",
            "daily_change_pct": "Daily change trigger (%)",
            "large_trade_usd": "Large trade threshold (USD)",
            "volume_spike_pct": "24h volume spike threshold (%)",
            "closing_soon_hours": "Closing soon threshold (hours)",
            "market_open_gap_pct": "Market-open gap threshold (%)",
            "extended_hours": "Track extended hours",
            "cooldown_min": "Cooldown per event type (minutes)"
          }
        },
        "reconfigure": {
          "title": "Edit options for {name}",
          "data": {
            "thresholds": "Thresholds (comma-separated)",
            "hysteresis": "Hysteresis",
            "move_delta": "Price move trigger",
            "move_window_min": "Price move window (minutes)",
            "daily_change_pct": "Daily change trigger (%)",
            "large_trade_usd": "Large trade threshold (USD)",
            "volume_spike_pct": "24h volume spike threshold (%)",
            "closing_soon_hours": "Closing soon threshold (hours)",
            "market_open_gap_pct": "Market-open gap threshold (%)",
            "extended_hours": "Track extended hours",
            "cooldown_min": "Cooldown per event type (minutes)"
          }
        }
      },
      "error": {
        "invalid_auth": "Invalid credentials.",
        "cannot_connect": "Could not reach the provider. Try again later.",
        "not_found": "No match found."
      },
      "abort": {
        "already_configured": "This instrument is already tracked under this account.",
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    }
  },
  "issues": {
